# DFTB Neu 测试环境（复制为 .env，勿提交）
# 也可不建本文件：启动时会自动读取并列目录 ../cmats-lab/.env 中的同名键。

DFTB_NEU_LLM_PROVIDER=deepseek

DFTB_NEU_DEEPSEEK_API_KEY=
DFTB_NEU_DEEPSEEK_BASE_URL=https://api.deepseek.com
DFTB_NEU_DEEPSEEK_MODEL=deepseek-v4-flash

DFTB_NEU_LLM_API_KEY=
DFTB_NEU_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DFTB_NEU_LLM_MODEL=qwen3.7-plus

DFTB_NEU_MP_API_KEY=

DFTB_NEU_HOST=127.0.0.1
DFTB_NEU_PORT=8765

# 课堂服务地址（安装包预置）。测试与正式均强制登录。
DFTB_NEU_CLASSROOM_HUB_URL=https://desktop-ibhgp7g.tailcc9705.ts.net
DFTB_NEU_LICENSE_REQUIRED=true
DFTB_NEU_LICENSE_OFFLINE_GRACE_HOURS=12
